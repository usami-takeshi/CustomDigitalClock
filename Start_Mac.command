#!/bin/bash
# ==============================================================================
# DigiClock - ワンクリック起動スクリプト (Mac用)
# このファイルをダブルクリックするだけで自動的にサーバーを起動し、ブラウザを開きます。
# ==============================================================================

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

echo "=================================================="
echo "  ⏰ DigiClock を起動しています..."
echo "  ブラウザが自動的に開きます。"
echo "  終了するときは、このウィンドウを閉じるか Ctrl + C を押してください。"
echo "=================================================="

# ブラウザを1秒後に自動で開く
(sleep 1 && open "http://localhost:8000") &

# サーバー起動 (server.py があれば使用、なければ標準モジュール)
if [ -f "server.py" ]; then
    python3 server.py
else
    python3 -m http.server 8000
fi
